# ---------------------------------------------------------------------------
# frontend/.env.example  ->  copy to frontend/.env and fill in.
#
# Anything prefixed VITE_ is compiled into the JS bundle and is PUBLIC.
# Only these three variables belong here. Never add an AI provider key or the
# Supabase service role key - a VITE_ prefixed secret is a published secret.
#
# The anon key is safe to expose ONLY because Row Level Security is enabled.
# Run supabase/verify_setup.sql and confirm before sharing a build.
# ---------------------------------------------------------------------------

# Dashboard > Project Settings > Data API
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Where the FastAPI backend is listening.
VITE_API_BASE_URL=http://localhost:8000
