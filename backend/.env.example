# ---------------------------------------------------------------------------
# backend/.env.example  ->  copy to backend/.env and fill in.
# backend/.env is gitignored. Never commit real values.
# ---------------------------------------------------------------------------

# ---- Supabase ----
# Dashboard > Project Settings > Data API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Dashboard > Project Settings > API Keys (service_role).
# NOT used by this MVP - every query runs as the caller so RLS applies.
# Present only so the variable is documented. Never log it, never ship it.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# OPTIONAL. Only needed for older projects that sign tokens with a shared
# HS256 secret. Current Supabase signs asymmetrically (ES256) and publishes
# the public key at /auth/v1/.well-known/jwks.json, which the backend
# fetches automatically - no secret required. Leave blank unless your
# project predates asymmetric signing.
SUPABASE_JWT_SECRET=

# ---- AI ----
# Which provider to call. Switching this requires no code change.
AI_PROVIDER=claude            # claude | openai | gemini
# Only the key matching AI_PROVIDER is required; startup fails loudly if it is
# missing. These stay server-side - no AI key may ever reach the browser.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional: pin a specific model id instead of the provider's default.
AI_MODEL_OVERRIDE=
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=1

# ---- App ----
# Comma-separated. Must include the frontend's dev origin.
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_GENERATE_PER_HOUR=10
RATE_LIMIT_REGENERATE_PER_HOUR=40
LOG_LEVEL=INFO
ENVIRONMENT=development
